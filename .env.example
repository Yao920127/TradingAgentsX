# ===== API Keys =====
# Note: In production, users provide their own API keys via the web interface.
# These server-side keys are optional and only used for CLI or testing.

# Optional: Server-side API Keys (not required for web interface)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional API Keys (for data sources)
ALPHA_VANTAGE_API_KEY=
FINMIND_API_KEY=

# News / social data sources (all optional; users can also enter them in the web settings,
# which take precedence over these server-side values)
FINNHUB_API_KEY=          # https://finnhub.io/register
MARKETAUX_API_KEY=        # https://www.marketaux.com/register
NEWSAPI_API_KEY=          # https://newsapi.org/register (free plan: development use only)
JINA_API_KEY=             # https://jina.ai/reader (reader works without a key; search needs one)
APIFY_API_TOKEN=          # https://console.apify.com/settings/integrations (StockTwits / X scrapers)
LUNARCRUSH_API_KEY=       # https://lunarcrush.com/developers/api/authentication (social endpoints need a paid plan)
REDDIT_CLIENT_ID=         # https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_SECRET=


# ===== Security Configuration =====

# JWT Secret - IMPORTANT: Change this in production!
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=dev-secret-please-change-in-production

# CORS Origins - Comma-separated list of allowed frontend URLs
# Example: CORS_ORIGINS=https://your-app.railway.app,https://your-frontend.vercel.app
# Leave empty to use default wildcard origins (less secure)
CORS_ORIGINS=

# Google OAuth (optional - for user authentication and persistent storage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000


# ===== Deployment Configuration =====
TRADINGAGENTS_RESULTS_DIR=/app/results
PYTHON_VERSION=3.13

# Frontend Configuration (for deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000